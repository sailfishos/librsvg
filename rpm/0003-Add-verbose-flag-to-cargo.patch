From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Matti Viljanen <matti.viljanen@jolla.com>
Date: Tue, 1 Apr 2025 11:22:36 +0300
Subject: [PATCH] Add verbose flag to cargo

---
 meson/cargo_wrapper.py | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/meson/cargo_wrapper.py b/meson/cargo_wrapper.py
index 48ce2f15e..ab4d3cad0 100755
--- a/meson/cargo_wrapper.py
+++ b/meson/cargo_wrapper.py
@@ -173,6 +173,8 @@ if features:
 for p in args.packages:
     cargo_cmd.extend(["-p", p])
 
+cargo_cmd.extend(["--verbose"])
+
 if args.command == "test":
     cargo_cmd.extend(["--", "--include-ignored"])
 
